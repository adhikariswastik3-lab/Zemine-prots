# Zemine Firebase Configuration
# Replace these with your actual keys from console.firebase.google.com
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=zemine-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zemine-app
VITE_FIREBASE_STORAGE_BUCKET=zemine-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
